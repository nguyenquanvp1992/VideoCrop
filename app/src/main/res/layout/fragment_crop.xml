<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTool"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/actionBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_back" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/actionDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@android:drawable/btn_star" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/original"
                style="@style/Button.ToolsVideo"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:text="original"
                app:layout_constraintBottom_toTopOf="@id/crop_4_5"
                app:layout_constraintEnd_toStartOf="@id/manual"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/actionDone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manual"
                style="@style/Button.ToolsVideo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="2dp"
                android:scaleType="center"
                android:text="Custom"
                app:layout_constraintBottom_toBottomOf="@id/original"
                app:layout_constraintEnd_toStartOf="@id/crop_1_1"
                app:layout_constraintStart_toEndOf="@id/original"
                app:layout_constraintTop_toTopOf="@id/original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_1_1"
                style="@style/Button.ToolsVideo"
                android:layout_marginHorizontal="2dp"
                android:text="1:1"
                app:layout_constraintBottom_toBottomOf="@id/original"
                app:layout_constraintEnd_toStartOf="@id/crop_9_16"
                app:layout_constraintStart_toEndOf="@id/manual"
                app:layout_constraintTop_toTopOf="@id/original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_9_16"
                style="@style/Button.ToolsVideo"
                android:layout_marginHorizontal="2dp"
                android:text="9:16"
                app:layout_constraintBottom_toBottomOf="@id/original"
                app:layout_constraintEnd_toStartOf="@id/crop_16_9"
                app:layout_constraintStart_toEndOf="@id/crop_1_1"
                app:layout_constraintTop_toTopOf="@id/original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_16_9"
                style="@style/Button.ToolsVideo"
                android:layout_marginHorizontal="2dp"
                android:text="16:9"
                app:layout_constraintBottom_toBottomOf="@id/original"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/crop_9_16"
                app:layout_constraintTop_toTopOf="@id/original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_4_5"
                style="@style/Button.ToolsVideo"
                android:text="4:5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/original"
                app:layout_constraintStart_toStartOf="@id/original"
                app:layout_constraintTop_toBottomOf="@id/original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_5_4"
                style="@style/Button.ToolsVideo"
                android:text="5:4"
                app:layout_constraintBottom_toBottomOf="@id/crop_4_5"
                app:layout_constraintEnd_toEndOf="@id/manual"
                app:layout_constraintStart_toStartOf="@id/manual"
                app:layout_constraintTop_toTopOf="@id/crop_4_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_3_4"
                style="@style/Button.ToolsVideo"
                android:text="3:4"
                app:layout_constraintBottom_toBottomOf="@id/crop_4_5"
                app:layout_constraintEnd_toEndOf="@id/crop_1_1"
                app:layout_constraintStart_toStartOf="@id/crop_1_1"
                app:layout_constraintTop_toTopOf="@id/crop_4_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crop_4_3"
                style="@style/Button.ToolsVideo"
                android:text="4:3"
                app:layout_constraintBottom_toBottomOf="@id/crop_4_5"
                app:layout_constraintEnd_toEndOf="@id/crop_9_16"
                app:layout_constraintStart_toStartOf="@id/crop_9_16"
                app:layout_constraintTop_toTopOf="@id/crop_4_5" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>